# Copy to backend/.env for local development.
# Every value below is also settable by an administrator at runtime under
# Admin -> Services; the environment always wins.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_development

# Signs access (15 min) and refresh (30 day) tokens.
JWT_SECRET=change-me-in-every-environment

# AES-256-GCM key for secrets stored in system_settings.
# WARNING: rotating this makes previously stored Stripe secrets undecryptable.
# The app then falls back to the env-provided Stripe keys below.
APP_SECRET=change-me-in-every-environment

# Object storage for uploaded DXF files (bucket "drawings" is created on first use).
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional. Without it, rate limiting falls back to an in-process window.
REDIS_URL=redis://localhost:6379

# Payments. Leave blank to run without checkout; the API answers 503 rather than faking one.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Order confirmation email. Optional — a failed send never blocks an order.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Comma-separated CORS origins (local `ng serve` only; production is same-origin).
FRONTEND_URL=http://localhost:4200
